{
  "name": "personal-view",
  "version": "0.1.0",
  "description": "Electron R2 media viewer",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer && electron-builder",
    "dev": "concurrently \"npm:dev:electron\" \"npm:dev:renderer\"",
    "dev:electron": "tsc -w -p tsconfig.electron.json",
    "dev:renderer": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently \"vite --host\" \"wait-on tcp:5173 file:dist-electron/main.js && electron .\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.521.0",
    "@aws-sdk/lib-storage": "^3.521.0",
    "@aws-sdk/s3-request-presigner": "^3.521.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
