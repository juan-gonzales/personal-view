{
  "name": "personal-view",
  "version": "0.1.0",
  "description": "Electron R2 media viewer",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "predev": "tsc -p tsconfig.electron.json",
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "prestart": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "prebuild": "tsc -p tsconfig.electron.json",
    "build": "vite build && electron-builder",
    "postinstall": "tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.521.0",
    "@aws-sdk/lib-storage": "^3.521.0",
    "@aws-sdk/s3-request-presigner": "^3.521.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
